<?xml version="1.0" encoding="utf-8"?>
<!-- SEG-3: lista blanca (Android 12 o más). Solo tema y aviso de voz; el resto de datos locales no sale del celular. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/preferencias_app.preferences_pb"/>
        <include domain="file" path="datastore/configuracion_voz.preferences_pb"/>
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/preferencias_app.preferences_pb"/>
        <include domain="file" path="datastore/configuracion_voz.preferences_pb"/>
    </device-transfer>
</data-extraction-rules>
